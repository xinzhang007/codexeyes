<Application x:Class="CodexEyes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="FaintBrush" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#2BFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#E61B2C43" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
    </Application.Resources>
</Application>
