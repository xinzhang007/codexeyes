<Window x:Class="CodexEyes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexEyes"
        Title="codexeyes"
        Width="260"
        Height="285"
        MinWidth="260"
        MinHeight="285"
        MaxWidth="260"
        MaxHeight="285"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="Card"
            Margin="1"
            Padding="10,20,10,12"
            CornerRadius="20"
            Background="{StaticResource CardBrush}"
            BorderBrush="#4AFFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="61" />
                <RowDefinition Height="112" />
                <RowDefinition Height="18" />
                <RowDefinition Height="1" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                <Ellipse Width="5" Height="5" Fill="{Binding AccentBrush}" Margin="0,4,7,0" />
                <TextBlock Text="CODEXEYES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="15" Background="#887BFF" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        <TextBlock x:Name="AvatarInitials" Text="C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Top">
                    <TextBlock x:Name="AccountName" Text="Codex" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Margin="0,4,0,0" Padding="4,2" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="#52FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="PlanType" Text="CODEX" FontSize="7" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,2,0,0" MouseLeftButtonUp="Summary_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="本周期已使用" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="PercentText" Text="0" FontFamily="Consolas" FontSize="47" FontWeight="Medium" />
                        <TextBlock Text="%" FontSize="20" Foreground="{StaticResource SubtleBrush}" Margin="4,0,0,4" />
                    </StackPanel>
                    <TextBlock x:Name="ResetText" Text="等待 Codex 数据" FontSize="10" Foreground="{StaticResource SubtleBrush}" Margin="0,1,0,0" />
                </StackPanel>
                <local:UsageRing x:Name="UsageRing" Grid.Column="1" Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,1,0" Percent="0" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,0">
                <Border Height="7" CornerRadius="4" Background="#2BFFFFFF" VerticalAlignment="Center" />
                <Border x:Name="ProgressFill" Height="7" Width="0" CornerRadius="4" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="4" Background="{StaticResource LineBrush}" />

            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="生成 tokens" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                    <TextBlock x:Name="GeneratedTokens" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="上下文 tokens" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                    <TextBlock x:Name="ContextTokens" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
